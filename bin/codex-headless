#!/bin/sh
# Run a bounded Codex job without creating a durable Codex session.
set -u

codex_headless_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$codex_headless_root/lib.sh"

codex_headless_python=$(helper_detect_python) || {
    printf '%s\n' 'codex-headless: Python 3 command not found' >&2
    exit 127
}

if [ "$codex_headless_python" = 'py -3' ]; then
    exec py -3 "$codex_headless_root/bin/codex_headless.py" "$@"
fi
exec "$codex_headless_python" "$codex_headless_root/bin/codex_headless.py" "$@"
