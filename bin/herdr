#!/bin/sh
# Inspect-by-default Herdr wrapper for Lantern.
# Mutating verbs need HERDR_HELPER_OK=1 in front of the same command.
set -u

self_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$self_dir/../lib.sh"
# herdr.cmd passes this file's Windows path. Keep one form so the comparison
# against HERDR_BIN_PATH in helper_resolve_real_herdr stays meaningful.
self_dir=$(helper_posix_path "$self_dir")

real=$(helper_resolve_real_herdr "$self_dir") || {
    printf 'lantern: could not find the real herdr binary\n' >&2
    exit 127
}

if helper_is_inspect "$@"; then
    exec "$real" "$@"
fi

case ${HERDR_HELPER_OK:-} in
1 | yes | true)
    if helper_is_agent_prompt "$@"; then
        helper_relay_agent_prompt "$real" "$@"
        exit $?
    fi
    if helper_is_agent_start "$@"; then
        kind=$(helper_argv_option_value --kind "$@") || kind=
        gemini_kind=0
        kind_count=0
        previous=
        for argument in "$@"; do
            [ "$argument" = -- ] && break
            if [ "$previous" = --kind ]; then
                kind_count=$((kind_count + 1))
                [ "$argument" = gemini ] && gemini_kind=1
            else
                case $argument in
                --kind=*)
                    kind_count=$((kind_count + 1))
                    [ "$argument" = --kind=gemini ] && gemini_kind=1
                    ;;
                esac
            fi
            previous=$argument
        done
        if [ "$gemini_kind" = 1 ] && [ "$kind_count" -ne 1 ]; then
            printf '%s\n' 'lantern: duplicate Herdr kind options cannot select a Gemini seat' >&2
            exit 2
        fi
        if [ "$kind" = gemini ]; then
            # Subshell preserves the original Herdr argv. Validate only
            # the native arguments after -- before contacting the target.
            (
                while [ $# -gt 0 ] && [ "$1" != -- ]; do shift; done
                [ $# -gt 0 ] && shift
                python=$(helper_detect_python) || exit 2
                # shellcheck disable=SC2086
                $python "$self_dir/gemini-start-check.py" "$@"
            ) || exit 2
        fi
        helper_relay_agent_start "$real" "$@"
        exit $?
    fi
    exec "$real" "$@"
    ;;
esac

printf 'lantern: blocked mutating herdr command:\n' >&2
printf '  herdr %s\n' "$*" >&2
printf 'Rerun with the prefix; ask the user first only when the target\n' >&2
printf 'is unclear:\n' >&2
printf '  HERDR_HELPER_OK=1 herdr %s\n' "$*" >&2
exit 2
