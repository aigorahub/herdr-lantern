#!/bin/sh
set -eu

model_preflight_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$model_preflight_root/lib.sh"

model_preflight_python=$(helper_detect_python) || {
    printf '%s\n' 'model-preflight: availability check failed: Python 3 command not found' >&2
    exit 2
}

if [ "$model_preflight_python" = 'py -3' ]; then
    exec py -3 "$model_preflight_root/bin/model-preflight.py" "$@"
fi
exec "$model_preflight_python" "$model_preflight_root/bin/model-preflight.py" "$@"
