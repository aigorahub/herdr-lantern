#!/bin/sh
set -eu

model_route_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$model_route_root/lib.sh"

model_route_python=$(helper_detect_python) || {
    printf '%s\n' 'model-route: Python 3 command not found' >&2
    exit 2
}

if [ "$model_route_python" = 'py -3' ]; then
    exec py -3 "$model_route_root/bin/model-route.py" "$@"
fi
exec "$model_route_python" "$model_route_root/bin/model-route.py" "$@"
