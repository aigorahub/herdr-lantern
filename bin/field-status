#!/bin/sh
# Render Lantern's compact field view with the Python 3 selected by the plugin.
set -u

field_status_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
# shellcheck disable=SC1091
. "$field_status_root/lib.sh"
field_status_python=$(helper_detect_python) || {
    printf '%s\n' 'field-status: Python 3 command not found' >&2
    exit 127
}
if [ "$field_status_python" = 'py -3' ]; then
    exec py -3 "$field_status_root/bin/field_status.py" "$@"
fi
exec "$field_status_python" "$field_status_root/bin/field_status.py" "$@"
